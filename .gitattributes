# Hemo ships Linux scripts authored on Windows. Store text as LF and CHECK OUT
# as LF everywhere, so shebangs/bash never see CRLF (which breaks on Linux).
* text=auto eol=lf

# Explicit LF for everything that runs on the target
*.sh      text eol=lf
*.yml     text eol=lf
*.ini     text eol=lf
*.rasi    text eol=lf
*.conf    text eol=lf
*.json    text eol=lf
*.service text eol=lf
*.plymouth text eol=lf
*.script  text eol=lf
*.txt     text eol=lf
# extensionless helper scripts
overlays/usr/local/bin/* text eol=lf
firstboot/*              text eol=lf

# Binary assets — never touch
*.jpg binary
*.jpeg binary
*.png binary
*.ttf binary
*.otf binary
*.7z  binary
