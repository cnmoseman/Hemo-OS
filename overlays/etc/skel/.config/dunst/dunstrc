# Hemo dunst — notifications in the Hemo palette, stacked top-right under the
# bar. Keys (config.d/hemo-keys.conf): $mod+n dismiss, $mod+Shift+n bring back
# the last one, $mod+Ctrl+n dismiss all.

[global]
    follow = mouse
    origin = top-right
    # 6px in from the edge, just under the floating bar (30px tall + 6px offset)
    offset = (6, 42)
    width = (240, 380)
    height = (0, 220)
    notification_limit = 5
    gap_size = 6

    font = JetBrainsMono Nerd Font Mono 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ellipsize = end
    ignore_newline = no
    show_age_threshold = 60

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#3f372f"
    separator_color = frame
    corner_radius = 8

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    highlight = "#c9a37a"

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

    history_length = 30
    sticky_history = yes

[urgency_low]
    background = "#1b1714"
    foreground = "#a39686"
    timeout = 4

[urgency_normal]
    background = "#1b1714"
    foreground = "#e8dfd4"
    timeout = 6

[urgency_critical]
    background = "#1b1714"
    foreground = "#e8dfd4"
    frame_color = "#c41e2f"
    timeout = 0
