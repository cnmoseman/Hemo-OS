#!/usr/bin/env python3
"""hemo-welcome — Hemo OS control center.

A reopenable GTK window that front-ends the hemo-* helpers: a header with the
lizard mark and live role, a grid of action cards each showing current status,
and an overview panel with the VPN / internal-IP / egress addresses. Launched from the menu,
and once per login from the i3 config (`hemo-welcome --autostart`, gated by a
per-user flag so it stops popping up once you turn it off, without deleting
itself — the EndeavourOS welcome pattern).

Privileged actions (role install, hardening, GPU, hostname) run via pkexec inside
a kitty terminal so output streams live and polkit prompts for the password once.
"""
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango, GdkPixbuf, Gio  # noqa: E402

REPO = "https://github.com/cnmoseman/Hemo-OS"
HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config/hemo/welcome.conf")
SELF = subprocess.run(["which", "hemo-welcome"], capture_output=True, text=True).stdout.strip() or os.path.abspath(__file__)
# Header toad mark, chosen per mode: the brown mark (`hemo-mark-dark.png`) reads
# on the light-mode surface, the cream mark (`hemo-mark.png`) on dark surfaces.
# Only `light` is a light surface; kali/black are dark. Falls back to the plymouth
# logo if the marks aren't installed.
def logo_candidates():
    light = _theme_mode() == "light"
    primary = "hemo-mark-dark.png" if light else "hemo-mark.png"
    secondary = "hemo-mark.png" if light else "hemo-mark-dark.png"
    out = []
    for name in (primary, secondary):
        out.append(f"/usr/share/hemo/branding/{name}")
        out.append(os.path.join(HOME, f"Hemo-OS/branding/assets/{name}"))
    out.append("/usr/share/plymouth/themes/hemo/logo.png")
    return out

# The "HemoOS" wordmark lettering cut from the logo (transparent, no disc/lizard),
# chosen per mode: the cream wordmark is white and vanishes on the light sidebar,
# so light mode uses the dark recolor (`hemo-wordmark-dark.png`).
def wordmark_candidates():
    light = _theme_mode() == "light"
    primary = "hemo-wordmark-dark.png" if light else "hemo-wordmark.png"
    secondary = "hemo-wordmark.png" if light else "hemo-wordmark-dark.png"
    out = []
    for name in (primary, secondary):
        out.append(f"/usr/share/hemo/branding/{name}")
        out.append(os.path.join(HOME, f"Hemo-OS/branding/assets/{name}"))
    return out

def _detect_accent():
    """The live accent so the welcome's own chrome matches the current theme."""
    try:
        t = open(os.path.join(HOME, ".config/gtk-3.0/hemo-accent.css")).read()
        m = re.search(r"#[0-9a-fA-F]{6}", t)
        if m:
            return m.group(0)
    except Exception:
        pass
    return "#c9a37a"


ACCENT = _detect_accent()
# The Hemo brand tan (Saddle dark accent, matches the logo). First-boot setup
# onboards BEFORE a role/accent is chosen, so its chrome always uses the brand
# tan rather than whatever accent happens to be applied (e.g. a themed box).
BRAND_TAN = "#c9a37a"
NERD = "JetBrainsMono Nerd Font Mono"

# Saddle fallback (if palette.env is missing), matching hemo-role-apply.
_SADDLE = {
    "dark":  dict(desk="#14110e", panel="#2c2621", border="#3f372f",
                  text="#e8dfd4", muted="#a39686", bad="#f08a80"),
    "light": dict(desk="#d9cfc2", panel="#e8e0d5", border="#cbbfae",
                  text="#2a241e", muted="#6b6157", bad="#b3261e"),
    "kali":  dict(desk="#1b1d24", panel="#2d303b", border="#40434f",
                  text="#ffffff", muted="#a0a3b1", bad="#ff5f5f"),
    "black": dict(desk="#000000", panel="#141414", border="#2a2a2a",
                  text="#e6e6e6", muted="#8c8c8c", bad="#f08a80"),
}
# Mode choices (id, label) — same set as hemo-role-apply's MODES.
MODE_CHOICES = (("dark", "Dark"), ("light", "Light"), ("kali", "Kali grey"), ("black", "Black"))
MODE_IDS = tuple(m for m, _ in MODE_CHOICES)
# Terminal color schemes (hemo-appearance termcolors / hemo-report TERMCOLORS).
TERMCOLOR_CHOICES = (("auto", "Match mode"), ("gruvbox", "Gruvbox"), ("kali", "Kali"),
                     ("dracula", "Dracula"), ("nord", "Nord"), ("solarized", "Solarized"),
                     ("tokyonight", "Tokyo Night"), ("catppuccin", "Catppuccin"),
                     ("onedark", "One Dark"))
# Shell prompt presets (/usr/share/hemo/prompts/<id>.toml), shown in Appearance.
PROMPT_CHOICES = (("stock", "Stock"), ("oneline", "One line"),
                  ("kali", "Hemo classic"), ("userhost", "user@host"),
                  ("engagement", "Engagement (VPN + target)"), ("timestamped", "Timestamped"))
# A plain-text sample of each prompt, shown as a live preview under the dropdown.
PROMPT_EXAMPLES = {
    "stock":       "~/hemo\n❯",
    "oneline":     "~/hemo ❯",
    "kali":        "┌──(hemo㉿hemo)-[~/hemo]\n└─$",
    "userhost":    "hemo@hemo ~/hemo ❯",
    "engagement":  " 10.10.14.3 → 10.10.11.42 ~/hemo ❯",
    "timestamped": "[12:21:05] hemo@hemo ~/hemo ❯",
}


def _theme_mode():
    v = ""
    try:                                   # rootless user preference wins
        v = open(os.path.join(HOME, ".config/hemo/mode")).read().strip()
    except OSError:
        try:
            for ln in open("/var/lib/hemo/theme.env"):
                if ln.startswith("HEMO_MODE="):
                    v = ln.strip().split("=", 1)[1]
        except OSError:
            pass
    v = str(v).strip().lower()
    return v if v in MODE_IDS else ("light" if v.startswith("l") else "dark")


def _mode_neutrals():
    """Neutral tokens for the current mode, from palette.env (else Saddle)."""
    pal = {}
    try:
        for ln in open("/usr/share/hemo/palette.env"):
            s = ln.strip()
            if s and not s.startswith("#") and "=" in s:
                k, _, v = s.partition("=")
                parts = v.split()
                pal[k.strip()] = parts[0] if parts else ""
    except OSError:
        pass
    mode = _theme_mode()
    M = mode.upper()
    return {k: (pal.get(f"HEMO_{M}_{k.upper()}") or _SADDLE[mode][k])
            for k in ("desk", "panel", "border", "text", "muted", "bad")}


