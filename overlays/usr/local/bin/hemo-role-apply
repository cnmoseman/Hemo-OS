def apply_firefox(home, mode, N, ui, selfg, uid, gid):
    """Write userChrome.css into every Firefox profile so the browser chrome
    matches the Hemo theme (mode neutrals + role accent), not the default grey.
    A delimited block in user.js enables userChrome/userContent and sets the
    dark/light base; prefs outside the block are preserved. userContent.css
    darkens Firefox's own pages (new tab / about:) so the body isn't grey."""
    import glob
    css = _FF_USERCHROME.format(win=N["win"], bar=N["bar"], panel=N["panel"],
                                border=N["border"], text=N["text"], accent=ui, selfg=selfg)
    content_css = _FF_USERCONTENT.format(win=N["win"], bar=N["bar"], panel=N["panel"], border=N["border"],
                                         text=N["text"], accent=ui)
    dark = 0 if base(mode) == "light" else 1
    # content/new-tab color-scheme: 0=dark 1=light (both prefs use this scale), so
    # the body matches the chrome instead of staying grey. Chrome via systemUsesDarkTheme.
    content = 1 if base(mode) == "light" else 0
    block = ("// >>> hemo (managed — do not edit)\n"
             'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n'
             'user_pref("ui.systemUsesDarkTheme", %d);\n'
             'user_pref("layout.css.prefers-color-scheme.content-override", %d);\n'
             'user_pref("browser.theme.content-theme", %d);\n'
             "// <<< hemo\n") % (dark, content, content)
    # Template for profiles that don't exist yet: the firefox-esr wrapper seeds a
    # fresh home's first profile from these, so it is themed on the first window.
    tdir = os.path.join(home, ".config", "hemo", "firefox")
    try:
        os.makedirs(tdir, exist_ok=True)
        for name, body in (("userChrome.css", css), ("userContent.css", content_css),
                           ("user.js", block)):
            with open(os.path.join(tdir, name), "w", encoding="utf-8") as fh:
                fh.write(body)
        _chown_all(uid, gid, os.path.dirname(tdir), tdir,
                   *[os.path.join(tdir, n) for n in ("userChrome.css", "userContent.css", "user.js")])
    except OSError:
        pass
    ffdir = os.path.join(home, ".mozilla", "firefox")
    for prof in glob.glob(os.path.join(ffdir, "*")):
        if not (os.path.isfile(os.path.join(prof, "prefs.js"))
                or os.path.isfile(os.path.join(prof, "times.json"))):
            continue                       # not a real profile dir
        chrome = os.path.join(prof, "chrome")
        cssf = os.path.join(chrome, "userChrome.css")
        contentf = os.path.join(chrome, "userContent.css")
        userjs = os.path.join(prof, "user.js")
        try:
            os.makedirs(chrome, exist_ok=True)
            with open(cssf, "w", encoding="utf-8") as fh:
                fh.write(css)
            with open(contentf, "w", encoding="utf-8") as fh:
                fh.write(content_css)
            try:
                cur = open(userjs, encoding="utf-8").read()
            except OSError:
                cur = ""
            cur = re.sub(r"// >>> hemo.*?// <<< hemo\n", "", cur, flags=re.S).rstrip("\n")
            with open(userjs, "w", encoding="utf-8") as fh:
                fh.write((cur + "\n" + block) if cur else block)
            if uid is not None:
                for f in (chrome, cssf, contentf, userjs):
                    try:
                        os.chown(f, uid, gid)
                    except OSError:
                        pass
        except OSError:
            pass


def apply_gtk(path, ui, uid, gid):
    write_generated(path, f"@define-color hemo_accent {ui};\n", uid, gid)


def apply_icon_theme(path, icons, uid, gid, home=None, user=None):
    """Point gtk-icon-theme-name at the role's Flat-Remix color variant, so the
    folder/app icons match the accent. No-op if the variant isn't installed.

    When the user has a Hemo-Net theme (accent Nerd-glyph network icons for the
    nm-applet tray), keep *that* as the active theme — it inherits the Flat-Remix
    variant — and just re-point its inherited base + regenerate the accent glyphs
    so the tray icon re-themes live with the role."""
    if not icons or not os.path.isdir(os.path.join("/usr/share/icons", icons)):
        if icons:
            log(f"icon theme '{icons}' not installed — leaving icons as-is")
        return
    hemonet = os.path.join(home, ".local/share/icons/Hemo-Net") if home else None
    use_hemonet = bool(hemonet and os.path.isdir(hemonet))
    target = "Hemo-Net" if use_hemonet else icons
    def fn(t):
        if re.search(r"(?m)^\s*gtk-icon-theme-name\s*=", t):
            return re.sub(r"(?m)^(\s*gtk-icon-theme-name\s*=\s*).*$", rf"\g<1>{target}", t)
        # no line yet: add it under [Settings] (or at the top if that's missing)
        if re.search(r"(?m)^\[Settings\]\s*$", t):
            return re.sub(r"(?m)^(\[Settings\]\s*)$", rf"\g<1>\ngtk-icon-theme-name={target}", t, count=1)
        return f"[Settings]\ngtk-icon-theme-name={target}\n" + t
    edit_file(path, fn, uid, gid)
    if use_hemonet and user:
        # rebuild Hemo-Net inheriting the new variant, re-render accent glyphs,
        # and bounce nm-applet — all in the user's live X session.
        _run_as_user(user, ["hemo-net-icons", "--base", icons])


def apply_i3(path, ui, N, uid, gid):
    title = on_accent(ui, N["text"])          # focused titlebar text, on the accent
    bad = N["bad"]
    colors = (
        f"client.focused          {ui} {ui} {title} {ui} {ui}\n"
        f"client.focused_inactive {N['border']} {N['bar']} {N['muted']} {N['border']} {N['border']}\n"
        f"client.unfocused        {N['win']} {N['desk']} {N['muted']} {N['win']} {N['win']}\n"
        f"client.urgent           {bad} {bad} {on_accent(bad, N['text'])} {bad} {bad}"
    )
    def fn(t):
        return replace_block(t, "colors", colors)
    edit_file(path, fn, uid, gid)


# Wallpaper treatment: recolor the art's (near-black) background to this tan and
# fill the whole screen with the same tan, so the subject keeps its zoomed-out size
# but floats on a seamless light field instead of a black box with margins.
WALLPAPER_PAD = os.environ.get("HEMO_WALLPAPER_PAD", "28%")
WALLPAPER_BG = os.environ.get("HEMO_WALLPAPER_BG", "#d9c7a3")   # light tan
WALLPAPER_FG = os.environ.get("HEMO_WALLPAPER_FG", "#fbf8ee")   # crisp cream (subject)


def _is_hemo_art(path):
    """Hemo's own lizard art (role wallpapers + the stock background) gets the
    zoomed-out framing; anyone else's photo is just filled to the screen."""
    real = os.path.realpath(path)
    return (real.startswith(os.path.realpath(WALLPAPER_DIR) + os.sep)
            or os.path.basename(real).startswith("hemo-bg"))


def _write_user_wallpaper(home, path, uid, gid):
    """Remember the source image (not the padded cache) so pywal derives from it."""
    p = os.path.join(home, ".config", "hemo", "wallpaper")
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as fh:
            fh.write(path + "\n")
        if uid is not None:
            os.chown(p, uid, gid)
    except OSError:
        pass


def _read_user_wallpaper(home):
    try:
        v = open(os.path.join(home, ".config", "hemo", "wallpaper")).read().strip()
        return v if os.path.isfile(v) else ""
    except OSError:
        return ""


def apply_wallpaper(home, wallpaper, desk, user, uid=None, gid=None):
    # a bare name is a role wallpaper in WALLPAPER_DIR; an absolute path is any image
    if wallpaper and os.path.isabs(wallpaper):
        path = wallpaper
    else:
        path = os.path.join(WALLPAPER_DIR, wallpaper) if wallpaper else ""
    bg = WALLPAPER_BG
    if path and os.path.exists(path) and not _is_hemo_art(path):
        _write_user_wallpaper(home, path, uid, gid)
        _run_as_user(user, ["feh", "--bg-fill", path])   # writes ~/.fehbg
        return
    if path and os.path.exists(path):
        _write_user_wallpaper(home, path, uid, gid)
        src = path
        if shutil.which("convert"):
            out = os.path.join(home, ".cache", "hemo", "wallpaper.png")
            try:
                os.makedirs(os.path.dirname(out), exist_ok=True)
                # Sample the top-left corner. A near-black corner = a cream-on-black
                # silhouette (recolor it to tan). Otherwise the art already has its
                # own background colour — keep it and pad with that colour.
                corner = subprocess.check_output(
                    ["convert", src, "-format", "%[pixel:p{2,2}]", "info:"],
                    text=True).strip()
                m = re.search(r"(\d+)[,\s]+(\d+)[,\s]+(\d+)", corner)
                cr = tuple(int(m.group(i)) for i in (1, 2, 3)) if m else (0, 0, 0)
                corner_hex = _hx(cr)
                if _lum(corner_hex) < 0.06:          # silhouette: recolor to tan
                    subprocess.call(["convert", src, "-sigmoidal-contrast", "10x45%",
                                     "-fuzz", "38%", "-fill", WALLPAPER_FG, "-opaque", "#ffffff",
                                     "-fuzz", "30%", "-fill", bg, "-opaque", "#000000",
                                     "-bordercolor", bg, "-border", WALLPAPER_PAD,
                                     "+repage", out],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                else:                                 # already coloured: just frame it
                    bg = corner_hex
                    subprocess.call(["convert", src, "-bordercolor", bg,
                                     "-border", WALLPAPER_PAD, "+repage", out],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if os.path.exists(out):
                    if uid is not None:
                        try:
                            os.chown(out, uid, gid)
                            os.chown(os.path.dirname(out), uid, gid)
                        except OSError:
                            pass
                    src = out
            except Exception:
                pass
        cmd = ["feh", "--bg-max", "--image-bg", bg, src]
    else:
        # no wallpaper art -> solid tan fill
        cmd = ["xsetroot", "-solid", bg]
        log(f"wallpaper '{wallpaper}' missing — solid fill ({bg})")
    # run inside the operator's X session if we can reach it
    _run_as_user(user, cmd)


def _session_xenv(user):
    """DISPLAY + XAUTHORITY of the user's live X session, read from the i3 process
    environ. Without XAUTHORITY a root->user runuser can't reach X, so polybar/feh
    silently fail to restart (the bar/wallpaper then look stale after a re-theme)."""
    disp = os.environ.get("DISPLAY", ":0")
    xauth = os.environ.get("XAUTHORITY", "")
    try:
        uid = pwd.getpwnam(user).pw_uid
        for pid in subprocess.check_output(["pgrep", "-x", "i3"], text=True).split():
            if os.stat(f"/proc/{int(pid)}").st_uid != uid:
                continue
            env = {}
            with open(f"/proc/{int(pid)}/environ", "rb") as fh:
                for kv in fh.read().split(b"\0"):
                    if b"=" in kv:
                        k, _, v = kv.partition(b"=")
                        env[k.decode(errors="replace")] = v.decode(errors="replace")
            disp = env.get("DISPLAY", disp)
            xauth = env.get("XAUTHORITY", xauth)
            break
    except Exception:
        pass
    if not xauth:
        xauth = os.path.join(pwd.getpwnam(user).pw_dir, ".Xauthority")
    return disp, xauth


def _run_as_user(user, cmd):
    me = pwd.getpwuid(os.geteuid()).pw_name
    disp, xauth = _session_xenv(user)
    try:
        if user == me and os.environ.get("DISPLAY"):
            subprocess.call(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            # exec the argv directly after setting the X env — NO `sh -c`, so a
            # literal '#rrggbb' arg isn't eaten as a shell comment, and a caller
            # that wants a shell just passes ["sh","-c","…"] itself.
            subprocess.call(
                ["runuser", "-u", user, "--", "env",
                 f"DISPLAY={disp}", f"XAUTHORITY={xauth}", *cmd],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
    except OSError:
        pass  # no live session (first boot) — i3's exec ~/.fehbg applies it next login


def apply_bookmarks(folders):
    """Rebuild the Firefox policy from the master, keeping only `folders`."""
    if os.geteuid() != 0:
        # re-apply just this part via sudo
        subprocess.call(["sudo", sys.argv[0], "--bookmarks-only",
                         ",".join(folders)])
        return
    if not os.path.exists(POLICY_MASTER):
        log(f"policy master missing: {POLICY_MASTER} — bookmarks unchanged")
        return
    with open(POLICY_MASTER, encoding="utf-8") as fh:
        policy = json.load(fh)
    keep = set(folders)
    marks = policy.get("policies", {}).get("Bookmarks", [])
    policy["policies"]["Bookmarks"] = [b for b in marks if b.get("Folder") in keep]
    os.makedirs(os.path.dirname(POLICY_LIVE), exist_ok=True)
    with open(POLICY_LIVE, "w", encoding="utf-8") as fh:
        json.dump(policy, fh, indent=2)
    log(f"Firefox bookmark folders: {', '.join(folders)}")


def _read_theme_env() -> dict:
    """Read the last-recorded theme.env (HEMO_PRIMARY / ACCENT / WALLPAPER)."""
    out = {}
    try:
        for ln in open(os.path.join(STATE_DIR, "theme.env"), encoding="utf-8"):
            k, _, v = ln.strip().partition("=")
            if k:
                out[k] = v
    except OSError:
        pass
    return out


def record_primary(role, accent, wallpaper, mode):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(os.path.join(STATE_DIR, "primary"), "w") as fh:
        fh.write(role + "\n")
    env = os.path.join(STATE_DIR, "theme.env")
    with open(env, "w") as fh:
        fh.write(f"HEMO_PRIMARY={role}\nHEMO_ACCENT={accent}\n"
                 f"HEMO_WALLPAPER={wallpaper}\nHEMO_MODE={mode}\n")


def _write_all(home, N, ansi, mode, ui, txt, selfg, uid, gid):
    """Write every neutral + accent across the configs, from an explicit palette.
    Shared by apply_color (Saddle) and the pywal path."""
    C = lambda *p: os.path.join(home, ".config", *p)
    neu_kitty(C("kitty/kitty.conf"), N, mode, uid, gid, ansi=ansi)
    apply_qterminal(home, N, mode, ansi, uid, gid)
    neu_polybar(C("polybar/config.ini"), N, mode, uid, gid)
    neu_rofi(C("rofi/config.rasi"), N, uid, gid)
    neu_rofi(C("rofi/pinned.rasi"), N, uid, gid)
    neu_dunst(C("dunst/dunstrc"), N, uid, gid)
    neu_gtk_defines(C("gtk-3.0/gtk.css"), N, selfg, uid, gid)
    apply_kitty(C("kitty/kitty.conf"), ui, txt, uid, gid)
    apply_polybar(C("polybar/config.ini"), ui, uid, gid)
    apply_polybar_focus(C("polybar/config.ini"), N, mode, ui, selfg, uid, gid)
    apply_dunst(C("dunst/dunstrc"), ui, uid, gid)
    apply_rofi(C("rofi/hemo-colors.rasi"), ui, txt, selfg, uid, gid)
    apply_gtk(C("gtk-3.0/hemo-accent.css"), ui, uid, gid)
    apply_i3(C("i3/config"), ui, N, uid, gid)
    apply_firefox(home, mode, N, ui, selfg, uid, gid)
    apply_flameshot(C("flameshot/flameshot.ini"), N, ui, uid, gid)
    apply_btop(home, N, mode, ui, txt, uid, gid)
    apply_qt(home, N, mode, ui, txt, selfg, uid, gid)
    apply_starship(home, N, mode, txt, uid, gid)
    apply_nvim(home, N, mode, ui, txt, selfg, uid, gid)
    apply_gimp(home, N, mode, ui, selfg, uid, gid)
    apply_cherrytree(home, N, mode, ui, txt, selfg, uid, gid)
    apply_fastfetch(home, txt, uid, gid)
    apply_tmux(home, N, ui, selfg, uid, gid)


# ---------------------------------------------------------------- more apps
def _chown_all(uid, gid, *paths):
    if uid is None:
        return
    for f in paths:
        try:
            os.chown(f, uid, gid)
        except OSError:
            pass


def apply_flameshot(path, N, ui, uid, gid):
    """Flameshot's capture UI (buttons, selection frame) in the accent. The
    annotation drawColor is the user's pick and stays. Flameshot watches its
    config, so a running daemon picks this up without a restart.
    Also ensures useX11LegacyScreenshot=true: Flameshot 14 otherwise captures via
    xdg-desktop-portal, which i3 lacks ("Screenshot portal timed out")."""
    def fn(t):
        if not re.search(r"(?m)^useX11LegacyScreenshot\s*=", t):
            t = re.sub(r"(?m)^\[General\]\s*$", "[General]\nuseX11LegacyScreenshot=true", t, count=1)
        t = re.sub(r"(?m)^(useX11LegacyScreenshot\s*=).*$", r"\g<1>true", t)
        return _sub_keys(t, [
            (r"(?m)^(uiColor=)#[0-9a-fA-F]{6}", ui),
            (r"(?m)^(contrastUiColor=)#[0-9a-fA-F]{6}", N["bar"]),
        ])
    edit_file(path, fn, uid, gid)


def apply_btop(home, N, mode, ui, txt, uid, gid):
    """~/.config/btop/themes/hemo.theme from the mode neutrals + accent, selected
    in btop.conf. Gauges run ok -> warn -> bad; boxes/titles wear the accent."""
    ok, warn, bad = N["ok"], N["warn"], N["bad"]
    soft = lambda h: _mix(h, N["win"], 0.45)       # dim start of a gradient
    th = {
        "main_bg": N["win"], "main_fg": N["text"], "title": N["text"],
        "hi_fg": txt, "selected_bg": N["panel"], "selected_fg": txt,
        "inactive_fg": N["muted"], "graph_text": N["muted"], "proc_misc": ok,
        "cpu_box": ui, "mem_box": ui, "net_box": ui, "proc_box": ui,
        "div_line": N["border"],
        "temp_start": ok, "temp_mid": warn, "temp_end": bad,
        "cpu_start": ok, "cpu_mid": warn, "cpu_end": bad,
        "free_start": soft(ok), "free_mid": "", "free_end": ok,
        "cached_start": soft(ui), "cached_mid": "", "cached_end": ui,
        "available_start": soft(warn), "available_mid": "", "available_end": warn,
        "used_start": soft(bad), "used_mid": "", "used_end": bad,
        "download_start": soft(ui), "download_mid": "", "download_end": ui,
        "upload_start": soft(ok), "upload_mid": "", "upload_end": ok,
    }
    d = os.path.join(home, ".config", "btop", "themes")
    os.makedirs(d, exist_ok=True)
    f = os.path.join(d, "hemo.theme")
    with open(f, "w", encoding="utf-8") as fh:
        fh.write("# generated by hemo-role-apply — do not edit; set via `hemo-theme <role>`\n")
        fh.write("".join(f'theme[{k}]="{v}"\n' for k, v in th.items()))
    conf = os.path.join(home, ".config", "btop", "btop.conf")
    if os.path.exists(conf):
        def fn(t):
            if re.search(r"(?m)^color_theme\s*=", t):
                return re.sub(r"(?m)^color_theme\s*=.*$", 'color_theme = "hemo"', t)
            return 'color_theme = "hemo"\n' + t
        edit_file(conf, fn, uid, gid)
    else:   # btop fills in every other key on its first run
        with open(conf, "w", encoding="utf-8") as fh:
            fh.write('color_theme = "hemo"\ntheme_background = True\n')
    _chown_all(uid, gid, os.path.dirname(d), d, f, conf)


def apply_qt(home, N, mode, ui, txt, selfg, uid, gid):
    """Qt6 apps (Wireshark, QTerminal, Flameshot's UI) via a qt6ct color scheme.
    The session's QT_QPA_PLATFORMTHEME=qt5ct also loads qt6ct for Qt6 apps.
    Apps read the palette at start, so open ones need a restart."""
    hi, lo = "#ffffff", "#000000"     # Light/Midlight lighter, Dark darker, any mode
    a = lambda h: "#ff" + h.lstrip("#").lower()
    # QPalette role order (21): WindowText Button Light Midlight Dark Mid Text
    # BrightText ButtonText Base Window Shadow Highlight HighlightedText Link
    # LinkVisited AlternateBase NoRole ToolTipBase ToolTipText PlaceholderText
    def row(fg):
        return [fg, N["panel"], _mix(N["panel"], hi, 0.15), _mix(N["panel"], hi, 0.07),
                _mix(N["panel"], lo, 0.40), N["border"], fg, "#ffffff", fg,
                N["bar"], N["win"], lo, ui, selfg, txt, _mix(txt, N["muted"], 0.5),
                N["panel"], N["win"], N["panel"], N["text"], N["muted"]]
    active, disabled = row(N["text"]), row(N["muted"])
    body = ("[ColorScheme]\n"
            f"active_colors={', '.join(map(a, active))}\n"
            f"disabled_colors={', '.join(map(a, disabled))}\n"
            f"inactive_colors={', '.join(map(a, active))}\n")
    d = os.path.join(home, ".config", "qt6ct", "colors")
    os.makedirs(d, exist_ok=True)
    scheme = os.path.join(d, "Hemo.conf")
    with open(scheme, "w", encoding="utf-8") as fh:
        fh.write(body)
    conf = os.path.join(home, ".config", "qt6ct", "qt6ct.conf")
    def fn(t):
        if not re.search(r"(?m)^\[Appearance\]", t):
            t = "[Appearance]\n" + t
        for k, v in (("custom_palette", "true"), ("color_scheme_path", scheme)):
            if re.search(rf"(?m)^{k}=", t):
                t = re.sub(rf"(?m)^{k}=.*$", f"{k}={v}", t)
            else:
                t = re.sub(r"(?m)^(\[Appearance\]\s*)$", rf"\g<1>\n{k}={v}", t, count=1)
        return t
    if not os.path.exists(conf):
        open(conf, "w").close()
    edit_file(conf, fn, uid, gid)
    _chown_all(uid, gid, os.path.dirname(d), d, scheme, conf)


def apply_starship(home, N, mode, txt, uid, gid):
    """Prompt colors: a [palettes.hemo] table the Hemo presets reference by name
    (accent, ok, bad, muted). Cached in ~/.config/hemo/starship-palette.toml so
    hemo-appearance can re-attach it when the prompt preset changes. In report
    mode the live prompt is the team standard's, so only the personal backup is
    themed."""
    block = ("[palettes.hemo]\n"
             f'accent = "{txt}"\n'
             f'ok = "{shade(N["ok"], N["win"], mode, 4.5)}"\n'
             f'bad = "{shade(N["bad"], N["win"], mode, 4.5)}"\n'
             f'warn = "{N["warn"]}"\n'
             f'muted = "{N["muted"]}"\n'
             f'text = "{N["text"]}"')
    cache = os.path.join(home, ".config", "hemo", "starship-palette.toml")
    os.makedirs(os.path.dirname(cache), exist_ok=True)
    with open(cache, "w", encoding="utf-8") as fh:
        fh.write(block + "\n")
    _chown_all(uid, gid, cache)
    report = os.path.exists(os.path.join(home, ".config", "hemo", "report.active"))
    live = os.path.join(home, ".config", "hemo", "report-backup", "starship.toml") if report \
        else os.path.join(home, ".config", "starship.toml")
    def fn(t):
        if not re.search(r'(?m)^palette\s*=', t):
            # top-level key: must sit before the first [table]
            m = re.search(r"(?m)^\[[A-Za-z0-9_.-]+\]\s*$", t)
            i = m.start() if m else len(t)
            t = t[:i] + 'palette = "hemo"\n\n' + t[i:]
        return replace_block(t, "starship", block)
    edit_file(live, fn, uid, gid)


def apply_fastfetch(home, txt, uid, gid):
    """fastfetch: the Hemo lizard logo and the info keys in the accent (text
    shade, legible on the terminal background). Only the two color values are
    rewritten, so the rest of the user's config.jsonc is left alone."""
    f = os.path.join(home, ".config", "fastfetch", "config.jsonc")
    if os.path.exists(f):
        edit_file(f, lambda t: _sub_keys(t, [
            (r'("1"\s*:\s*")#[0-9a-fA-F]{6}', txt),
            (r'("keys"\s*:\s*")#[0-9a-fA-F]{6}', txt),
        ]), uid, gid)

def apply_tmux(home, N, ui, selfg, uid, gid):
    """tmux status bar themed to the role: a generated hemo-colors.conf that
    tmux.conf sources, so the bar/panes follow accent + mode like the others.
    Only written if the user has a tmux config dir (skel ships one)."""
    d = os.path.join(home, ".config", "tmux")
    if not os.path.isdir(d):
        return
    block = "\n".join([
        "# generated by hemo-role-apply — sourced by tmux.conf. Do not edit.",
        f'set -g status-style "bg={N["bar"]},fg={N["text"]}"',
        f'set -g status-left-style "bg={N["panel"]},fg={N["text"]},bold"',
        f'set -g window-status-style "fg={N["muted"]}"',
        f'set -g window-status-current-style "bg={ui},fg={selfg},bold"',
        f'set -g pane-border-style "fg={N["border"]}"',
        f'set -g pane-active-border-style "fg={ui}"',
        f'set -g message-style "bg={N["panel"]},fg={N["text"]}"',
        f'set -g mode-style "bg={ui},fg={selfg}"',
        f'set -g clock-mode-colour "{ui}"',
        "",
    ])
    f = os.path.join(d, "hemo-colors.conf")
    with open(f, "w", encoding="utf-8") as fh:
        fh.write(block)
    _chown_all(uid, gid, f)
    # a running tmux picks it up on next start or `prefix + r`; no live reload
    # here, matching the other non-desktop writers.

def apply_nvim(home, N, mode, ui, txt, selfg, uid, gid):
    """LazyVim: recolor tokyonight's UI (backgrounds, gutter, borders, statusline,
    selection) from the neutrals + accent. Syntax colors stay tokyonight's own
    (moon / day per base mode) so code stays readable under any accent or pywal.
    Only written when a LazyVim config exists; Neovim reads it at start."""
    nv = os.path.join(home, ".config", "nvim")
    if not os.path.exists(os.path.join(nv, "lua", "config", "lazy.lua")):
        return
    light = base(mode) == "light"
    w, bar, pan = N["win"], N["bar"], N["panel"]
    H = {
        "bg": w, "bg_dark": bar, "bg_dark1": N["desk"], "bg_highlight": pan,
        "bg_popup": bar, "bg_statusline": bar, "bg_sidebar": bar, "bg_float": bar,
        "bg_visual": _mix(ui, w, 0.70), "bg_search": _mix(ui, w, 0.45),
        "fg": N["text"], "fg_dark": _mix(N["text"], N["muted"], 0.5),
        "fg_float": N["text"], "fg_sidebar": _mix(N["text"], N["muted"], 0.5),
        "fg_gutter": _mix(N["border"], N["muted"], 0.35), "comment": _mix(N["muted"], w, 0.20),
        "dark3": _mix(N["muted"], w, 0.35), "dark5": N["muted"],
        "border": N["border"], "border_highlight": ui,
        "black": N["desk"], "terminal_black": N["border"],
    }
    A = {"ui": ui, "txt": txt, "on": selfg, "bar": bar, "panel": pan,
         "text": N["text"], "border": N["border"],
         "ok": shade(N["ok"], bar, mode, 3.0), "warn": shade(N["warn"], bar, mode, 3.0),
         "bad": shade(N["bad"], bar, mode, 3.0)}
    lua = lambda d: "{\n" + "".join(f'  {k} = "{v}",\n' for k, v in d.items()) + "}"
    body = f"""-- generated by hemo-role-apply — do not edit; set via `hemo-theme <role>`
local H = {lua(H)}
local A = {lua(A)}

local function mode(fill)
  return {{
    a = {{ bg = fill, fg = A.bar, gui = "bold" }},
    b = {{ bg = A.panel, fg = fill }},
    c = {{ bg = A.bar, fg = A.text }},
  }}
end

return {{
  {{
    "folke/tokyonight.nvim",
    opts = {{
      style = "{'day' if light else 'moon'}",
      light_style = "day",
      on_colors = function(c)
        for k, v in pairs(H) do c[k] = v end
      end,
      on_highlights = function(hl, c)
        hl.CursorLineNr = {{ fg = A.txt, bold = true }}
        hl.FloatBorder = {{ fg = A.ui, bg = H.bg_float }}
        hl.FloatTitle = {{ fg = A.txt, bg = H.bg_float, bold = true }}
        hl.WinSeparator = {{ fg = A.border, bold = true }}
        hl.Title = {{ fg = A.txt, bold = true }}
        hl.MatchParen = {{ fg = A.txt, bold = true }}
        hl.IncSearch = {{ bg = A.ui, fg = A.on }}
        hl.CurSearch = hl.IncSearch
        hl.PmenuSel = {{ bg = H.bg_visual, bold = true }}
        hl.TabLineSel = {{ bg = A.ui, fg = A.on }}
        hl.BufferLineIndicatorSelected = {{ fg = A.ui }}
        hl.SnacksDashboardHeader = {{ fg = A.txt }}
        hl.SnacksDashboardIcon = {{ fg = A.txt }}
        hl.SnacksDashboardKey = {{ fg = A.txt }}
        hl.NoiceCmdlinePopupBorder = {{ fg = A.ui }}
        hl.NoiceCmdlineIcon = {{ fg = A.txt }}
        hl.WhichKeyGroup = {{ fg = A.txt }}
      end,
    }},
  }},
  {{
    "nvim-lualine/lualine.nvim",
    opts = function(_, opts)
      local fill = A.ui
      local t = {{
        normal = mode(fill), insert = mode(A.ok), visual = mode(A.warn),
        replace = mode(A.bad), command = mode(A.txt), terminal = mode(A.ok),
        inactive = {{ a = {{ bg = A.bar, fg = H.dark5 }}, b = {{ bg = A.bar, fg = H.dark5 }},
                     c = {{ bg = A.bar, fg = H.dark5 }} }},
      }}
      t.normal.a.fg = A.on
      opts.options = opts.options or {{}}
      opts.options.theme = t
    end,
  }},
}}
"""
    f = os.path.join(nv, "lua", "plugins", "hemo-theme.lua")
    os.makedirs(os.path.dirname(f), exist_ok=True)
    with open(f, "w", encoding="utf-8") as fh:
        fh.write(body)
    _chown_all(uid, gid, f)


def _gimp_dirs(home):
    """GIMP 3 profile dirs (~/.config/GIMP/3.x). None yet (GIMP never run): make
    the one for the installed version, so the first launch is already themed."""
    root = os.path.join(home, ".config", "GIMP")
    dirs = sorted(glob.glob(os.path.join(root, "3.*")))
    if dirs:
        return dirs
    try:
        v = subprocess.run(["dpkg-query", "-W", "-f", "${Version}", "gimp"],
                           capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    m = re.match(r"(3\.\d+)", v)
    return [os.path.join(root, m.group(1))] if m else []


def apply_gimp(home, N, mode, ui, selfg, uid, gid):
    """GIMP 3 brings its own theme and ignores gtk.css. Its theme.css imports the
    user's gimp.css last, so redefining the theme's named colors there recolors
    every widget; the Dark/Light scheme (icons, handles) follows the base mode.
    GIMP reads both at start, so an open GIMP needs a restart."""
    light = base(mode) == "light"
    rgba = lambda h, a: "rgba(%d,%d,%d,%s)" % (*_rgb(h), a)
    edge = _mix(N["border"], N["text"], 0.15) if light else N["desk"]
    c = {
        "fg-color": N["text"], "bg-color": N["win"], "border-color": edge,
        "dimmed-fg-color": N["muted"],
        "disabled-fg-color": _mix(N["muted"], N["win"], 0.25),
        "disabled-button-color": _mix(N["muted"], N["win"], 0.55),
        "hover-color": _mix(ui, N["win"], 0.75 if light else 0.6),
        "widget-bg-color": N["bar"],
        "selected-color": _mix(ui, N["win"], 0.7 if light else 0.5),
        "extreme-bg-color": _mix(N["win"], "#ffffff", 0.5) if light else N["desk"],
        "extreme-selected-color": N["border"] if light else N["panel"],
        "strong-border-color": N["border"] if light else N["bar"],
        "stronger-border-color": edge if light else N["border"],
        "edge-border-color": edge,
        "scrollbar-slider-color": N["muted"], "scrollbar-trough-color": N["win"],
        "ruler-color": rgba(N["bar"], 0.3),
    }
    body = "".join(f"@define-color {k:<23}{v};\n" for k, v in c.items()) + f"""
selection, *:selected {{ background-color: {ui}; color: {selfg}; }}
check:checked, radio:checked {{ background-color: {ui}; border-color: {ui}; color: {selfg}; }}
scale highlight, progressbar trough progress {{ background-color: {ui}; }}
"""
    scheme = "light" if light else "dark"
    for d in _gimp_dirs(home):
        new = not os.path.isdir(d)
        os.makedirs(d, exist_ok=True)
        write_generated(os.path.join(d, "gimp.css"), body, uid, gid)
        rc = os.path.join(d, "gimprc")
        if not os.path.exists(rc):
            open(rc, "w").close()
        def fn(t):
            line = f"(theme-color-scheme {scheme})"
            if re.search(r"(?m)^\(theme-color-scheme\s", t):
                return re.sub(r"(?m)^\(theme-color-scheme\s[^)]*\)", line, t)
            return t + ("" if t.endswith("\n") or not t else "\n") + line + "\n"
        edit_file(rc, fn, uid, gid)
        _chown_all(uid, gid, rc, *((os.path.dirname(d), d) if new else ()))


def _ini_set(t, section, key, val):
    """Set key=val inside [section] of a GLib keyfile, adding either as needed."""
    sec = re.search(rf"(?m)^\[{re.escape(section)}\]\s*$", t)
    if not sec:
        return t + ("" if t.endswith("\n") or not t else "\n") + f"[{section}]\n{key}={val}\n"
    nxt = re.search(r"(?m)^\[", t[sec.end():])
    end = sec.end() + nxt.start() if nxt else len(t)
    body = t[sec.end():end]
    pat = rf"(?m)^{re.escape(key)}=.*$"
    if re.search(pat, body):
        body = re.sub(pat, lambda _m: f"{key}={val}", body)
    else:
        body = f"\n{key}={val}" + body
    return t[:sec.end()] + body + t[end:]


def apply_cherrytree(home, N, mode, ui, txt, selfg, uid, gid):
    """Cherrytree: its widgets already follow gtk.css; the text panes, tree and
    links have their own colors. A generated GtkSourceView scheme `hemo` (UI
    styles only; syntax colors inherit Kali-Dark/Kali-Light for readability, as
    with apply_nvim) drives all four editors, and config.cfg gets the tree +
    link + monospace colors. Cherrytree rewrites config.cfg on exit, so close
    it before a theme change or the old colors come back."""
    light = base(mode) == "light"
    parent = "Kali-Light" if light else "Kali-Dark"
    if not glob.glob(f"/usr/share/gtksourceview-4/styles/{parent}.xml"):
        parent = "classic" if light else "oblivion"
    cur = _mix(N["panel"], ui, 0.12)
    sel = _mix(ui, N["win"], 0.55 if light else 0.4)
    scheme = f"""<?xml version="1.0" encoding="UTF-8"?>
<!-- generated by hemo-role-apply — do not edit; set via `hemo-theme <role>` -->
<style-scheme id="hemo" name="Hemo" version="1.0" parent-scheme="{parent}">
  <author>Hemo OS</author>
  <description>Hemo neutrals + role accent over {parent}'s syntax colors</description>
  <style name="text"                foreground="{N['text']}" background="{N['win']}"/>
  <style name="selection"           foreground="{N['text']}" background="{sel}"/>
  <style name="selection-unfocused" foreground="{N['text']}" background="{N['border']}"/>
  <style name="cursor"              foreground="{ui}"/>
  <style name="current-line"        background="{cur}"/>
  <style name="current-line-number" foreground="{txt}" background="{cur}"/>
  <style name="line-numbers"        foreground="{N['muted']}" background="{N['bar']}"/>
  <style name="right-margin"        foreground="{N['border']}" background="{N['panel']}"/>
  <style name="draw-spaces"         foreground="{N['border']}"/>
  <style name="background-pattern"  background="{N['bar']}"/>
  <style name="bracket-match"       foreground="{selfg}" background="{ui}" bold="true"/>
  <style name="search-match"        foreground="{selfg}" background="{ui}"/>
</style-scheme>
"""
    sd = os.path.join(home, ".local", "share", "gtksourceview-4", "styles")
    os.makedirs(sd, exist_ok=True)
    sf = os.path.join(sd, "hemo.xml")
    with open(sf, "w", encoding="utf-8") as fh:
        fh.write(scheme)
    cd = os.path.join(home, ".config", "cherrytree")
    os.makedirs(cd, exist_ok=True)
    conf = os.path.join(cd, "config.cfg")
    if not os.path.exists(conf):
        open(conf, "w").close()
    sets = [("editor", k, "hemo") for k in
            ("rt_style_scheme", "pt_style_scheme", "ta_style_scheme", "co_style_scheme")]
    sets += [("colors", k, v) for k, v in (
        ("tt_def_fg", N["text"]), ("tt_def_bg", N["bar"]),
        ("tt_sel_fg", selfg), ("tt_sel_bg", ui),
        ("monospace_fg", txt), ("monospace_bg", N["panel"]),
        ("col_link_webs", txt), ("col_link_node", N["ok"]),
        ("col_link_file", N["warn"]), ("col_link_fold", N["muted"]))]
    def fn(t):
        for s, k, v in sets:
            t = _ini_set(t, s, k, v)
        return t
    edit_file(conf, fn, uid, gid)
    # a leftover config.cfg.tmp (Cherrytree killed mid-save) is restored over
    # config.cfg at next start, so it gets the same edits
    if os.path.exists(conf + ".tmp"):
        edit_file(conf + ".tmp", fn, uid, gid)
    _chown_all(uid, gid, *[os.path.join(home, ".local", "share", p) for p in
                           ("gtksourceview-4", "gtksourceview-4/styles")], sf, cd, conf)


def apply_color(home, raw, mode, pal, uid, gid, user):
    """Write every neutral (per MODE) and the shaded accent across the configs.
    `raw` is the role/custom accent before shading. Returns the stored accent (raw)."""
    N = neutrals(mode, pal)
    win = N["win"]
    ui = shade(raw, win, mode, 3.0)     # borders / fills / bar (>=3:1)
    txt = shade(raw, win, mode, 4.5)    # accent-colored text / links (>=4.5:1)
    selfg = on_accent(ui, N["text"])    # text ON an accent fill (white or body text)
    # remember the raw accent in a USER-writable file so a later mode switch (run
    # as root) can re-shade it, and the custom Appearance color survives.
    _write_user_accent(home, raw, uid, gid)
    _write_all(home, N, None, mode, ui, txt, selfg, uid, gid)   # None: neu_kitty picks the scheme
    refresh_net_icons(home, user)
    log(f"color: accent {raw} -> ui {ui} / text {txt}  (mode {mode})")
    return raw


def refresh_net_icons(home, user):
    """Re-render the Hemo-Net tray glyphs (nm-applet) in the accent just written to
    gtk-3.0/hemo-accent.css. Without this the network icon kept the old accent after
    a custom color, a mode switch or pywal — only a role switch re-rendered it."""
    if user and os.path.isdir(os.path.join(home, ".local/share/icons/Hemo-Net")):
        _run_as_user(user, ["hemo-net-icons"])


def _wal_regen(home, user, uid, light):
    """Re-run wal on the image it last used, in light (-l) or dark polarity, so a
    mode switch under pywal gets a scheme of the right polarity. False if it can't."""
    img = ""
    try:
        with open(os.path.join(home, ".cache", "wal", "wal")) as fh:
            img = fh.read().strip()
    except OSError:
        pass
    img = img if os.path.isfile(img) else _read_user_wallpaper(home)
    wal = shutil.which("wal") or "/usr/local/bin/wal"
    if not img or not os.path.isfile(img) or not os.path.exists(wal):
        return False
    # -n: don't set the wallpaper; -s/-t/-e: don't touch terminals/reload (Hemo applies)
    cmd = [wal, "-i", img, *(["-l"] if light else []), "-n", "-s", "-t", "-e", "-q"]
    if os.geteuid() != uid:
        cmd = ["runuser", "-u", user, "--", *cmd]
    try:
        return subprocess.call(cmd, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=120) == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def apply_pywal(home, mode, uid, gid, user):
    """Override Hemo's theme with a wallpaper-derived scheme from pywal's cache
    (~/.cache/wal/colors.json). No contrast guarantees — that is the opt-in cost.
    The mode still counts: a light/dark flip re-derives wal in that polarity, and
    kali/black keep their own surfaces while hues/accent follow the wallpaper."""
    cache = os.path.join(home, ".cache", "wal", "colors.json")
    def load():
        try:
            with open(cache) as fh:
                return json.load(fh)
        except (OSError, ValueError):
            return None
    w = load()
    if w is None:
        log("pywal cache missing — run: hemo-pywal on")
        return False
    cached_light = _lum(w.get("special", {}).get("background", "#000000")) > 0.4
    if cached_light != (base(mode) == "light"):
        if _wal_regen(home, user, uid, base(mode) == "light"):
            w = load() or w
        else:
            log("pywal: could not re-derive for this mode — using the cached scheme")
    sp = w.get("special", {})
    cols = w.get("colors", {})
    c = [cols.get(f"color{i}", "#000000") for i in range(16)]
    bg = sp.get("background", c[0])
    fg = sp.get("foreground", c[15])
    def lighten(h, p):   # blend toward white/black to synthesise missing shades
        return _mix(h, "#ffffff" if base(mode) == "dark" else "#000000", p)
    N = {
        "desk":   lighten(bg, 0.04) if base(mode) == "light" else _mix(bg, "#000000", 0.25),
        "bar":    bg,
        "win":    bg,
        "panel":  c[0] if c[0].lower() != bg.lower() else lighten(bg, 0.10),
        "border": c[8],
        "text":   fg,
        "muted":  _mix(fg, bg, 0.45),
        "ok": c[2], "warn": c[3], "bad": c[1],
    }
    if mode in ("kali", "black"):   # the mode's own surfaces; the wallpaper keeps the hues
        M = neutrals(mode, load_palette())
        N.update({k: M[k] for k in ("desk", "bar", "win", "panel", "border", "text", "muted")})
    # accent = the most-saturated of the pywal hues (reads as "the" accent)
    def sat(h):
        r, g, b = [x / 255 for x in _rgb(h)]
        mx, mn = max(r, g, b), min(r, g, b)
        return 0 if mx == 0 else (mx - mn) / mx
    accent = max(c[1:7], key=sat)
    ui = shade(accent, N["win"], mode, 3.0)
    txt = shade(accent, N["win"], mode, 4.5)
    selfg = on_accent(ui, N["text"])
    ansi = {i: c[i] for i in range(16)}
    _write_all(home, N, ansi, mode, ui, txt, selfg, uid, gid)
    refresh_net_icons(home, user)
    log(f"pywal: wallpaper scheme applied (accent {accent})")
    return True


def _user_accent_path(home):
    return os.path.join(home, ".config", "hemo", "accent")


def _write_user_accent(home, raw, uid, gid):
    p = _user_accent_path(home)
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as fh:
            fh.write(raw.strip() + "\n")
        if uid is not None:
            os.chown(p, uid, gid)
            os.chown(os.path.dirname(p), uid, gid)
    except OSError:
        pass


def _read_user_accent(home):
    try:
        with open(_user_accent_path(home)) as fh:
            v = fh.read().strip()
        return v if re.fullmatch(r"#[0-9a-fA-F]{6}", v) else ""
    except OSError:
        return ""


def _user_mode(home):
    """Rootless mode preference (~/.config/hemo/mode): dark|light|kali|black."""
    try:
        with open(os.path.join(home, ".config", "hemo", "mode")) as fh:
            v = fh.read().strip().lower()
        return v if v in MODES else ""
    except OSError:
        return ""


def _write_user_mode(home, mode, uid, gid):
    p = os.path.join(home, ".config", "hemo", "mode")
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as fh:
            fh.write(mode + "\n")
        if uid is not None:
            os.chown(p, uid, gid)
    except OSError:
        pass


def reload_desktop(user):
    for cmd in (["i3-msg", "reload"], ["i3-msg", "restart"]):
        _run_as_user(user, cmd)
    # bar, terminals and notifications re-read their configs (neutrals/accent).
    # i3 relaunches the bar so it inherits the session env, not this caller's; a
    # bar parented to a terminal/tool shell launched its click actions (power menu)
    # from there.
    _run_as_user(user, ["i3-msg", "-q",
        'exec --no-startup-id "killall -q polybar; sleep 0.4; exec polybar main"'])
    _run_as_user(user, ["sh", "-c",
        "pkill -USR1 kitty 2>/dev/null; dunstctl reload 2>/dev/null; true"])


# ---------------------------------------------------------------- main
def main(argv):
    # internal: the sudo re-entry for the system policy file only
    if len(argv) >= 3 and argv[1] == "--bookmarks-only":
        apply_bookmarks([f for f in argv[2].split(",") if f])
        return

    pal = load_palette()

    # print-only: kitty color lines for an explicit look, to stdout. Writes nothing,
    # touches no live config — hemo-shotterm layers it over kitty.conf (`-c`) so the
    # screenshot terminal matches the report standard whatever the daily theme is.
    #   --kitty-print MODE ACCENT [TERMCOLORS] [TERMFG]
    if len(argv) >= 4 and argv[1] == "--kitty-print":
        mode, raw = norm_mode(argv[2]), argv[3].strip()
        scheme = argv[4].strip().lower() if len(argv) >= 5 else "auto"
        tfg = argv[5].strip() if len(argv) >= 6 else "default"
        if mode not in MODES or not re.fullmatch(r"#[0-9a-fA-F]{6}", raw):
            log("usage: hemo-role-apply --kitty-print MODE #rrggbb [TERMCOLORS] [TERMFG]")
            sys.exit(1)
        N = neutrals(mode, pal)
        s = _SCHEMES.get(scheme)
        ansi = (s.get(base(mode)) or s["dark"]) if s else _ANSI[mode]
        fg = tfg if re.fullmatch(r"#[0-9a-fA-F]{6}", tfg) else N["text"]
        out = [("background", N["win"]), ("foreground", fg),
               ("selection_background", N["border"]), ("selection_foreground", N["text"]),
               ("cursor", shade(raw, N["win"], mode, 3.0)), ("cursor_text_color", N["win"]),
               ("url_color", shade(raw, N["win"], mode, 4.5))]
        out += [(f"color{i}", ansi[i]) for i in range(16)]
        print("\n".join(f"{k} {v}" for k, v in out))
        return

    # Rewrite BOTH qtermwidget color schemes (Hemo + HemoShot) using the current
    # live theme (Hemo) and the report standard (HemoShot). Root-only — the
    # system dir /usr/share/qtermwidget*/color-schemes is the only place
    # qtermwidget >=2.4 reads from. Used by provision and by hemo-report when
    # the report standard changes. Takes no args.
    if len(argv) >= 2 and argv[1] == "--qterminal-schemes":
        if os.geteuid() != 0:
            log("--qterminal-schemes must run as root")
            sys.exit(1)
        user = target_user()
        pw = pwd.getpwnam(user)
        home, uid, gid = pw.pw_dir, pw.pw_uid, pw.pw_gid
        mode = current_mode(pal, home)
        N = neutrals(mode, pal)
        apply_qterminal(home, N, mode, None, uid, gid, pal=pal)
        log(f"qterminal schemes rewritten (user {user}, mode {mode})")
        return

    # Same palette as --kitty-print, emitted as a qtermwidget .colorscheme, so a
    # qterminal can be locked to the report standard the same way kitty is.
    #   --qterminal-print MODE ACCENT [TERMCOLORS] [TERMFG]
    if len(argv) >= 4 and argv[1] == "--qterminal-print":
        mode, raw = norm_mode(argv[2]), argv[3].strip()
        scheme = argv[4].strip().lower() if len(argv) >= 5 else "auto"
        tfg = argv[5].strip() if len(argv) >= 6 else "default"
        if mode not in MODES or not re.fullmatch(r"#[0-9a-fA-F]{6}", raw):
            log("usage: hemo-role-apply --qterminal-print MODE #rrggbb [TERMCOLORS] [TERMFG]")
            sys.exit(1)
        N = neutrals(mode, pal)
        s = _SCHEMES.get(scheme)
        ansi = (s.get(base(mode)) or s["dark"]) if s else _ANSI[mode]
        fg = tfg if re.fullmatch(r"#[0-9a-fA-F]{6}", tfg) else N["text"]
        print(qterminal_scheme(N, fg, ansi), end="")
        return

    # appearance override: re-tint the accent to ANY hex (custom color from the
    # Appearance panel), keeping role / icons / wallpaper / bookmarks. The hex is
    # the RAW accent; it is shaded per the current mode. User-owned files only.
    if len(argv) >= 3 and argv[1] == "--accent":
        hexv = argv[2].strip()
        if not re.fullmatch(r"#[0-9a-fA-F]{6}", hexv):
            log(f"bad accent '{hexv}' (want #rrggbb)")
            sys.exit(1)
        user = target_user()
        pw = pwd.getpwnam(user)
        home, uid, gid = pw.pw_dir, pw.pw_uid, pw.pw_gid
        mode = current_mode(pal, home)
        # user-owned files + the user accent store only — NO /var/lib/hemo write,
        # so this works without root (the Appearance panel calls it as the user).
        apply_color(home, hexv, mode, pal, uid, gid, user)
        log(f"accent -> {hexv} (user {user}, mode {mode})")
        reload_desktop(user)
        return

    # mode switch (dark/light/kali/black). Re-applies neutrals + the current accent (shaded
    # for the new mode); keeps role / wallpaper / bookmarks / icons.
    if len(argv) >= 3 and argv[1] == "--mode":
        want = argv[2].strip().lower()
        if want not in MODES:
            log("usage: hemo-role-apply --mode " + "|".join(MODES))
            sys.exit(1)
        user = target_user()
        pw = pwd.getpwnam(user)
        home, uid, gid = pw.pw_dir, pw.pw_uid, pw.pw_gid
        prev = _read_theme_env()
        # prefer the user's custom accent (set via Appearance) over the recorded one
        raw = _read_user_accent(home) or prev.get("HEMO_ACCENT") or neutrals(want, pal)["accent"]
        # rootless: store the mode in the user file (so a hotkey/Appearance toggle
        # needs no pkexec), then apply.
        _write_user_mode(home, want, uid, gid)
        # if pywal has taken over, the scheme comes from the wallpaper, not Saddle
        if os.path.exists(os.path.join(home, ".config/hemo/pywal")):
            apply_pywal(home, want, uid, gid, user)
        else:
            apply_color(home, raw, want, pal, uid, gid, user)
        # re-pad the wallpaper so its margin matches the new mode's desk color
        # (the user's own pick from Appearance wins over the role's)
        wall = _read_user_wallpaper(home) or prev.get("HEMO_WALLPAPER", "")
        if wall:
            apply_wallpaper(home, wall, neutrals(want, pal)["desk"], user, uid, gid)
        log(f"mode -> {want} (user {user})")
        reload_desktop(user)
        return

    # wallpaper only (Appearance > Wallpaper): any image path. Hemo art gets the
    # same zoomed-out framing as role wallpapers; other images fill the screen.
    # feh writes ~/.fehbg so it sticks across logins. Rootless.
    if len(argv) >= 3 and argv[1] == "--wallpaper":
        path = os.path.abspath(os.path.expanduser(argv[2]))
        if not os.path.isfile(path):
            log(f"no such image: {path}")
            sys.exit(1)
        user = target_user()
        pw = pwd.getpwnam(user)
        home, uid, gid = pw.pw_dir, pw.pw_uid, pw.pw_gid
        mode = current_mode(pal, home)
        apply_wallpaper(home, path, neutrals(mode, pal)["desk"], user, uid, gid)
        log(f"wallpaper -> {path}")
        return

    # terminal-only refresh (hemo-appearance's Terminal colors): rewrite kitty's
    # neutrals + 16 colors for the current mode/scheme and reload kitty. Rootless.
    if len(argv) >= 2 and argv[1] == "--kitty":
        user = target_user()
        pw = pwd.getpwnam(user)
        home, uid, gid = pw.pw_dir, pw.pw_uid, pw.pw_gid
        if os.path.exists(os.path.join(home, ".config/hemo/pywal")):
            log("pywal is on — it owns the terminal colors; leaving them")
            return
        mode = current_mode(pal, home)
        neu_kitty(os.path.join(home, ".config", "kitty", "kitty.conf"), neutrals(mode, pal), mode, uid, gid)
        _run_as_user(user, ["pkill", "-USR1", "kitty"])
        log(f"terminal colors refreshed (mode {mode})")
        return

    # pywal: apply the wallpaper-derived scheme from pywal's cache (called by
    # hemo-pywal after it runs `wal`). Overrides the Saddle theme. Rootless.
    if len(argv) >= 2 and argv[1] == "--pywal":
        user = target_user()
        pw = pwd.getpwnam(user)
        home, uid, gid = pw.pw_dir, pw.pw_uid, pw.pw_gid
        mode = current_mode(pal, home)
        if apply_pywal(home, mode, uid, gid, user):
            reload_desktop(user)
        return

    theme_only = False
    # which parts of the role profile to apply. Default = everything (first boot,
    # and any caller that doesn't ask for less). `hemo-theme` / `hemo-roles` /
    # the welcome pass a subset here so a later role switch keeps the parts the
    # operator chose to keep (e.g. a custom Appearance color).
    ALL_ASPECTS = ("color", "wallpaper", "bookmarks", "icons")
    aspects = set(ALL_ASPECTS)
    args = argv[1:]
    while args and args[0].startswith("--"):
        if args[0] == "--theme-only":
            theme_only = True
            args = args[1:]
        elif args[0] == "--aspects":
            if len(args) < 2:
                log("--aspects needs a comma list (color,wallpaper,bookmarks,icons)")
                sys.exit(1)
            req = {a.strip() for a in args[1].split(",") if a.strip()}
            req = {"color" if a == "accent" else a for a in req}  # accent -> color
            bad = req - set(ALL_ASPECTS)
            if bad:
                log(f"unknown aspect(s): {', '.join(sorted(bad))}")
                sys.exit(1)
            aspects = req
            args = args[2:]
        else:
            log(f"unknown flag: {args[0]}")
            sys.exit(1)
    if len(args) != 1:
        sys.stderr.write(__doc__)
        sys.exit(1)
    role = args[0]
    if not aspects:
        log("no aspects selected — nothing to change")
        return

    roles = load_roles()
    if role not in roles:
        log(f"unknown role: {role}")
        sys.exit(1)
    prof = (roles[role].get("profile", {}) or {})
    accent = prof.get("accent", "#c9a37a")
    wallpaper = prof.get("wallpaper", "hemo-bg.png")
    bookmarks = prof.get("bookmarks", []) or []
    icons = prof.get("icons", "")

    user = target_user()
    pw = pwd.getpwnam(user)
    home = pw.pw_dir
    uid, gid = pw.pw_uid, pw.pw_gid

    kept = [a for a in ALL_ASPECTS if a not in aspects]
    log(f"primary role -> {role}  (accent {accent}, user {user})"
        + (f"  [applying: {', '.join(sorted(aspects))}]" if kept else ""))
    if kept:
        log(f"keeping existing: {', '.join(kept)}")

    mode = current_mode(pal, home)
    if "color" in aspects:
        apply_color(home, accent, mode, pal, uid, gid, user)
    if "icons" in aspects:
        apply_icon_theme(os.path.join(home, ".config/gtk-3.0/settings.ini"), icons, uid, gid, home, user)
    if "wallpaper" in aspects:
        apply_wallpaper(home, wallpaper, neutrals(mode, pal)["desk"], user, uid, gid)
    if "bookmarks" in aspects:
        apply_bookmarks(bookmarks)
    # Record the role as primary regardless; the accent/wallpaper we store is what
    # is actually live now — keep the prior values for aspects we didn't touch.
    prev = _read_theme_env()
    rec_accent = accent if "color" in aspects else prev.get("HEMO_ACCENT", accent)
    rec_wall = wallpaper if "wallpaper" in aspects else prev.get("HEMO_WALLPAPER", wallpaper)
    record_primary(role, rec_accent, rec_wall, mode)

    # refresh a running session (no-op on first boot, before login)
    reload_desktop(user)
    log("done" + ("" if not theme_only else " (theme only)"))


if __name__ == "__main__":
    main(sys.argv)
