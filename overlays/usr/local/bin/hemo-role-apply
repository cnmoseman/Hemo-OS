def _appr(kitty_conf, key):
    """A value from the user's Appearance store (~/.config/hemo/appearance.conf,
    written by hemo-appearance), located next to the given kitty.conf."""
    store = os.path.join(os.path.dirname(os.path.dirname(kitty_conf)), "hemo", "appearance.conf")
    try:
        for ln in open(store, encoding="utf-8"):
            k, _, v = ln.strip().partition("=")
            if k == key:
                return v.strip()
    except OSError:
        pass
    return ""


def _term_fg(kitty_conf):
    """User's terminal text color (Appearance > Terminal text), or "" for the mode default."""
    v = _appr(kitty_conf, "termfg")
    return v if re.fullmatch(r"#[0-9a-fA-F]{6}", v) else ""


def term_ansi(kitty_conf, mode):
    """The 16 terminal colors: the user's chosen scheme (Appearance > Terminal
    colors), its light variant in light-based modes when it has one; else the mode's own."""
    s = _SCHEMES.get(_appr(kitty_conf, "termcolors"))
    if not s:
        return _ANSI[mode]
    return s.get(base(mode)) or s["dark"]


def neu_kitty(path, N, mode, uid, gid, ansi=None):
    ansi = ansi or term_ansi(path, mode)
    fg = _term_fg(path) or N["text"]
    def fn(t):
        subs = [
            (r"(?m)^(background\s+)#[0-9a-fA-F]{6}", N["win"]),
            (r"(?m)^(foreground\s+)#[0-9a-fA-F]{6}", fg),
            (r"(?m)^(selection_background\s+)#[0-9a-fA-F]{6}", N["border"]),
            (r"(?m)^(selection_foreground\s+)#[0-9a-fA-F]{6}", N["text"]),
            (r"(?m)^(cursor_text_color\s+)#[0-9a-fA-F]{6}", N["win"]),
        ]
        for i in range(16):
            subs.append((rf"(?m)^(color{i}\s+)#[0-9a-fA-F]{{6}}", ansi[i]))
        return _sub_keys(t, subs)
    edit_file(path, fn, uid, gid)


def qterminal_scheme(N, fg, ansi) -> str:
    """A qtermwidget `.colorscheme` (INI) carrying the SAME palette as the kitty
    theme: mode background/foreground from the neutrals, the 16 ANSI "font colors"
    as Color0..7 (normal) + Color0..7Intense (bright 8..15). Opaque so report
    captures are consistent."""
    def c(h):
        return "%d,%d,%d" % _rgb(h)
    out = ["[General]", "Description=Hemo", "Opacity=1.0", "",
           "[Background]", f"Color={c(N['win'])}", "",
           "[BackgroundIntense]", f"Color={c(N['win'])}", "",
           "[Foreground]", f"Color={c(fg)}", "",
           "[ForegroundIntense]", f"Color={c(fg)}", ""]
    for i in range(8):
        out += [f"[Color{i}]", f"Color={c(ansi[i])}", "",
                f"[Color{i}Intense]", f"Color={c(ansi[i + 8])}", ""]
    return "\n".join(out) + "\n"


def _qtermwidget_versions() -> list:
    """The qtermwidget major(s) installed, e.g. ['qtermwidget6'] — read from the
    system color-scheme dirs so the user scheme lands where this qterminal scans."""
    import glob
    vers = sorted({os.path.basename(os.path.dirname(d))
                   for d in glob.glob("/usr/share/qtermwidget*/color-schemes")})
    return vers or ["qtermwidget6"]


def _report_standard(home):
    """Return (mode, accent, termcolors, termfg) from the report standard —
    per-user override under ~/.config/hemo/report/, else the shipped
    /usr/share/hemo/report/. Falls back to ('dark', '#c41e2f', 'auto', 'default')
    if the file is missing or a key is unset."""
    out = {"MODE": "dark", "ACCENT": "#c41e2f", "TERMCOLORS": "auto", "TERMFG": "default"}
    for p in (os.path.join(home, ".config", "hemo", "report", "profile.env"),
              "/usr/share/hemo/report/profile.env"):
        try:
            with open(p, "r", encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k = k.strip()
                    if k in out:
                        out[k] = v.strip()
            break  # per-user wins; stop before falling through to system
        except OSError:
            continue
    return out["MODE"], out["ACCENT"], out["TERMCOLORS"], out["TERMFG"]


def _build_hemoshot_body(pal, home):
    """Compute the HemoShot palette body (report-standard-fed). Returns None on
    an unrecoverable config error."""
    mode, raw, tc, tfg = _report_standard(home)
    mode = norm_mode(mode)
    if mode not in MODES or not re.fullmatch(r"#[0-9a-fA-F]{6}", raw):
        return None
    N = neutrals(mode, pal)
    s = _SCHEMES.get(tc.lower()) if tc else None
    ansi = (s.get(base(mode)) or s["dark"]) if s else _ANSI[mode]
    fg = tfg if re.fullmatch(r"#[0-9a-fA-F]{6}", tfg or "") else N["text"]
    return qterminal_scheme(N, fg, ansi)


def apply_qterminal(home, N, mode, ansi, uid, gid, pal=None):
    """Theme qterminal to match the role: write `Hemo.colorscheme` + a
    report-standard `HemoShot.colorscheme`. qtermwidget >=2.4 (current Kali)
    enumerates ONLY `/usr/share/qtermwidget*/color-schemes/`, so system-dir
    writes are the authoritative path when running as root; per-user writes
    stay for older qtermwidget builds."""
    kconf = os.path.join(home, ".config", "kitty", "kitty.conf")
    ansi = ansi or term_ansi(kconf, mode)
    fg = _term_fg(kconf) or N["text"]
    body = qterminal_scheme(N, fg, ansi)
    if pal is None:
        pal = load_palette()
    shot = _build_hemoshot_body(pal, home)
    is_root = os.geteuid() == 0
    # per-user copies (forward-compat; qtermwidget pre-2.4 scanned both)
    share = os.path.join(home, ".local", "share")
    for v in _qtermwidget_versions():
        d = os.path.join(share, v, "color-schemes")
        os.makedirs(d, exist_ok=True)
        for name, text in (("Hemo", body), ("HemoShot", shot)):
            if text is None:
                continue
            p = os.path.join(d, f"{name}.colorscheme")
            with open(p, "w", encoding="utf-8") as fh:
                fh.write(text)
            if uid is not None:
                for q in (os.path.join(share, v), d, p):
                    try:
                        os.chown(q, uid, gid)
                    except OSError:
                        pass
    # system-wide copies — the only path qtermwidget 2.4+ actually reads.
    # Needs root; silently no-op otherwise (user-level accent toggles can't do
    # this, but a root re-theme/role-apply from Welcome/provision does).
    if is_root:
        for v in _qtermwidget_versions():
            d = os.path.join("/usr/share", v, "color-schemes")
            try:
                os.makedirs(d, exist_ok=True)
            except OSError:
                continue
            for name, text in (("Hemo", body), ("HemoShot", shot)):
                if text is None:
                    continue
                p = os.path.join(d, f"{name}.colorscheme")
                try:
                    with open(p, "w", encoding="utf-8") as fh:
                        fh.write(text)
                    os.chmod(p, 0o644)
                except OSError:
                    pass
    # point qterminal at the Hemo scheme and the Nerd Font. Plain JetBrains Mono has
    # no braille glyphs, so qterminal renders fastfetch's braille logo through a
    # proportional fallback (DejaVu Sans) and smooshes it; JetBrainsMono Nerd Font
    # Mono carries the braille + icons and is monospace. (kitty is left alone — it
    # renders braille with its own built-in engine.)
    ini = os.path.join(home, ".config", "qterminal.org", "qterminal.ini")
    want = {"colorScheme": "Hemo", "fontFamily": "JetBrainsMono Nerd Font Mono"}
    def _set_general(t):
        if not re.search(r"(?m)^\[General\]\s*$", t):
            t = "[General]\n" + t
        for k, v in want.items():
            if re.search(rf"(?m)^{k}=", t):
                t = re.sub(rf"(?m)^{k}=.*$", f"{k}={v}", t)
            else:
                t = re.sub(r"(?m)^(\[General\]\s*)$", rf"\1\n{k}={v}", t, count=1)
        return t
    if os.path.exists(ini):
        edit_file(ini, _set_general, uid, gid)
    else:
        os.makedirs(os.path.dirname(ini), exist_ok=True)
        with open(ini, "w", encoding="utf-8") as fh:
            fh.write("[General]\ncolorScheme=Hemo\n"
                     "fontFamily=JetBrainsMono Nerd Font Mono\nfontSize=11\n")
        if uid is not None:
            try:
                os.chown(ini, uid, gid)
            except OSError:
                pass


def neu_polybar(path, N, mode, uid, gid):
    # semantic bar colors, shaded for the mode so they stay legible on the bar
    moss = shade(MOSS, N["bar"], mode, 3.0)
    blood = shade(BLOOD, N["bar"], mode, 3.0)

    def fn(t):
        # capture the current semantic literals so inline %{F#hex} uses (which
        # polybar can't expand from ${colors.x} inside a format) can be retinted
        om = re.search(r"(?m)^moss\s*=\s*(#[0-9a-fA-F]{6})", t)
        ob = re.search(r"(?m)^blood\s*=\s*(#[0-9a-fA-F]{6})", t)
        t = _sub_keys(t, [
            (r"(?m)^(background\s*=\s*)#[0-9a-fA-F]{6}", N["bar"]),
            (r"(?m)^(surface\s*=\s*)#[0-9a-fA-F]{6}", N["panel"]),
            (r"(?m)^(foreground\s*=\s*)#[0-9a-fA-F]{6}", N["text"]),
            (r"(?m)^(muted\s*=\s*)#[0-9a-fA-F]{6}", N["muted"]),
            (r"(?m)^(moss\s*=\s*)#[0-9a-fA-F]{6}", moss),
            (r"(?m)^(blood\s*=\s*)#[0-9a-fA-F]{6}", blood),
        ])
        # retint inline literals of the old semantic colors
        for old, new in ((om, moss), (ob, blood)):
            if old and old.group(1).lower() != new.lower():
                for v in {old.group(1), old.group(1).lower(), old.group(1).upper()}:
                    t = t.replace("%{F" + v + "}", "%{F" + new + "}")
        # separator glyph color (inline %{F#hex})
        return re.sub(r'(separator\s*=\s*"%\{F)#[0-9a-fA-F]{6}(\})',
                      rf'\g<1>{N["border"]}\g<2>', t)
    edit_file(path, fn, uid, gid)


def neu_rofi(path, N, uid, gid):
    def fn(t):
        return _sub_keys(t, [
            (r"(?m)^(\s*bg:\s*)#[0-9a-fA-F]{6}", N["bar"]),
            (r"(?m)^(\s*surface:\s*)#[0-9a-fA-F]{6}", N["panel"]),
            (r"(?m)^(\s*line:\s*)#[0-9a-fA-F]{6}", N["border"]),
            (r"(?m)^(\s*fg:\s*)#[0-9a-fA-F]{6}", N["text"]),
            (r"(?m)^(\s*muted:\s*)#[0-9a-fA-F]{6}", N["muted"]),
            (r"(?m)^(\s*border-color:\s*)#[0-9a-fA-F]{6}", N["border"]),
        ])
    edit_file(path, fn, uid, gid)


def neu_dunst(path, N, uid, gid):
    def fn(t):
        return _sub_keys(t, [
            (r'(?m)^(\s*frame_color\s*=\s*")#[0-9a-fA-F]{6}', N["border"]),
            (r'(?m)^(\s*background\s*=\s*")#[0-9a-fA-F]{6}', N["bar"]),
            # all urgencies -> readable body text for the mode (loses the subtle
            # low-urgency muted tint, but keeps text legible on the light bar)
            (r'(?m)^(\s*foreground\s*=\s*")#[0-9a-fA-F]{6}', N["text"]),
        ])
    edit_file(path, fn, uid, gid)


def apply_dunst(path, ui, uid, gid):
    """dunst's progress-bar highlight follows the shaded accent (per mode/role)."""
    def fn(t):
        return re.sub(r'(?m)^(\s*highlight\s*=\s*")#[0-9a-fA-F]{6}', rf'\g<1>{ui}', t)
    edit_file(path, fn, uid, gid)


def neu_gtk_defines(path, N, selfg, uid, gid):
    """gtk.css carries all neutrals as @define-color; rewrite those lines."""
    def fn(t):
        return _sub_keys(t, [
            (r"(?m)^(@define-color theme_bg_color\s+)#[0-9a-fA-F]{6}", N["win"]),
            (r"(?m)^(@define-color theme_base_color\s+)#[0-9a-fA-F]{6}", N["panel"]),
            (r"(?m)^(@define-color theme_fg_color\s+)#[0-9a-fA-F]{6}", N["text"]),
            (r"(?m)^(@define-color theme_text_color\s+)#[0-9a-fA-F]{6}", N["text"]),
            (r"(?m)^(@define-color theme_selected_fg_color\s+)#[0-9a-fA-F]{6}", selfg),
            (r"(?m)^(@define-color borders\s+)#[0-9a-fA-F]{6}", N["border"]),
            (r"(?m)^(@define-color unfocused_borders\s+)#[0-9a-fA-F]{6}", N["border"]),
            (r"(?m)^(@define-color hemo_bar\s+)#[0-9a-fA-F]{6}", N["bar"]),
            (r"(?m)^(@define-color hemo_muted\s+)#[0-9a-fA-F]{6}", N["muted"]),
        ])
    edit_file(path, fn, uid, gid)


# ---------------------------------------------------------------- target user
def target_user() -> str:
    # 1) explicit caller: sudo sets SUDO_USER, pkexec sets PKEXEC_UID (the welcome
    #    installs via pkexec, which does NOT set SUDO_USER — honouring PKEXEC_UID
    #    keeps us on the real operator instead of the lowest-uid account).
    u = os.environ.get("SUDO_USER", "")
    if u and u != "root":
        return u
    for var in ("PKEXEC_UID", "SUDO_UID"):
        v = os.environ.get(var, "")
        if v.isdigit() and int(v) != 0:
            try:
                return pwd.getpwuid(int(v)).pw_name
            except KeyError:
                pass
    if os.geteuid() == 0:
        # 2) whoever is running the live desktop (the session we want to re-theme)
        try:
            pids = subprocess.check_output(["pgrep", "-x", "i3"], text=True).split()
            if pids:
                uid = os.stat(f"/proc/{int(pids[0])}").st_uid
                return pwd.getpwuid(uid).pw_name
        except Exception:
            pass
        # 3) last resort: lowest uid in the human range (NOT uid-ordered by default)
        humans = sorted((p for p in pwd.getpwall() if 1000 <= p.pw_uid < 65534),
                        key=lambda p: p.pw_uid)
        if humans:
            return humans[0].pw_name
    return pwd.getpwuid(os.geteuid()).pw_name


def load_roles() -> dict:
    with open(os.path.join(MANIFEST_DIR, "roles.yml"), encoding="utf-8") as fh:
        return (yaml.safe_load(fh) or {}).get("roles", {}) or {}


def replace_block(text: str, region: str, body: str) -> str:
    """Replace content between the region's markers, or append the block."""
    start = f"# >>> hemo:{region}"
    end = f"# <<< hemo:{region}"
    block = f"{start}\n{body}\n{end}"
    pat = re.compile(re.escape(start) + r".*?" + re.escape(end), re.DOTALL)
    if pat.search(text):
        return pat.sub(lambda _m: block, text)
    sep = "" if text.endswith("\n") else "\n"
    return f"{text}{sep}\n{block}\n"


def edit_file(path, fn, uid=None, gid=None):
    try:
        with open(path, encoding="utf-8") as fh:
            old = fh.read()
    except FileNotFoundError:
        log(f"skip (not found): {path}")
        return
    new = fn(old)
    if new == old:
        return
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(new)
    if uid is not None:
        try:
            os.chown(path, uid, gid)
        except OSError:
            pass


# ---------------------------------------------------------------- appliers
def apply_kitty(path, ui, txt, uid, gid):
    def fn(t):
        t = re.sub(r"(?m)^(cursor\s+)#[0-9a-fA-F]{6}\s*$", rf"\g<1>{ui}", t)       # UI
        t = re.sub(r"(?m)^(url_color\s+)#[0-9a-fA-F]{6}\s*$", rf"\g<1>{txt}", t)   # link text
        return t
    edit_file(path, fn, uid, gid)


def apply_polybar(path, accent, uid, gid):
    def fn(t):
        m = re.search(r"(?m)^accent\s*=\s*(#[0-9a-fA-F]{6})\s*$", t)
        old = m.group(1) if m else None
        t = re.sub(r"(?m)^(accent\s*=\s*)#[0-9a-fA-F]{6}\s*$", rf"\g<1>{accent}", t)
        # inline icon colors that use the accent (cpu/memory/egress modules write
        # it as a literal %{F#hex} because polybar won't expand ${colors.accent}
        # inside a format string) — retint them too. Semantic colors (moss=network,
        # blood=target) are different hexes and stay put.
        if old and old.lower() != accent.lower():
            for o in {old, old.lower(), old.upper()}:
                t = t.replace("%{F" + o + "}", "%{F" + accent + "}")
        return t
    edit_file(path, fn, uid, gid)


def apply_polybar_focus(path, N, mode, ui, selfg, uid, gid):
    """Focused-workspace tile ([colors] focus-bg / focus-fg). Dark bases keep the
    accent text on the panel tint; on the light bar that tint is nearly the bar's
    own color and the accent text washes out, so light bases fill the tile with
    the accent and put on-accent text over it."""
    if base(mode) == "light":
        bg, fg = ui, selfg
    else:
        bg, fg = N["panel"], ui
    def fn(t):
        for key, val in (("focus-fg", fg), ("focus-bg", bg)):
            pat = rf"(?m)^({re.escape(key)}\s*=\s*)#[0-9a-fA-F]{{6}}"
            if re.search(pat, t):
                t = re.sub(pat, rf"\g<1>{val}", t)
            else:   # older config without the keys: add them under [colors]
                t = re.sub(r"(?m)^(\[colors\]\s*)$", rf"\g<1>\n{key:<10} = {val}", t, count=1)
        return t
    edit_file(path, fn, uid, gid)


def write_generated(path, body, uid, gid):
    """(Re)write a whole generated CSS-style file, owned by the user."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("/* generated by hemo-role-apply — do not edit; set via `hemo-theme <role>` */\n" + body)
    if uid is not None:
        try:
            os.chown(path, uid, gid)
        except OSError:
            pass


def apply_rofi(path, ui, txt, on, uid, gid):
    write_generated(path, f"* {{\n    hemo-accent: {ui};\n    hemo-accent-text: {txt};\n"
                          f"    hemo-accent-on: {on};\n}}\n", uid, gid)


