#!/usr/bin/env python3
"""hemo-role-apply — make a role the PRIMARY: apply its theme to the desktop.

The primary role alone drives the look of the box. This writes that role's
`profile:` block (from manifest/roles.yml) into the live config:

    accent      -> kitty (cursor/url), polybar [colors].accent, rofi accent,
                   i3 client.focused border
    wallpaper   -> feh --bg-fill (falls back to a solid dark fill if the art
                   file is missing — per-role wallpapers are an art TODO)
    bookmarks   -> rebuilds /etc/firefox-esr/policies/policies.json from the
                   master, keeping only this role's toolbar folders

(Workspaces are plain numbers for every role and live as static bindings in
i3/config — they're not themed.)

Config files carry managed regions between
    # >>> hemo:<region>   ...   # <<< hemo:<region>
markers; only the text between the markers is rewritten, so hand edits outside
them survive.

Runs as the operator, or as root (first boot / `sudo`) targeting the operator's
home. The Firefox policy always needs root; when not root it is re-applied via
sudo.

Usage:
    hemo-role-apply <role>                     # first boot: apply the whole profile
    hemo-role-apply --theme-only <role>        # theme only (used by `hemo-theme`)
    hemo-role-apply --aspects color,icons <role>
                                               # apply only these parts, keep the rest
                                               # (color|wallpaper|bookmarks|icons;
                                               #  default = all)
    hemo-role-apply --accent '#rrggbb'         # custom accent (shaded for the mode)
    hemo-role-apply --mode dark|light|kali|black   # switch mode, keep role + accent
    hemo-role-apply --wallpaper /path/img.png  # set the wallpaper (Hemo art is framed)

Neutral colors come from /usr/share/hemo/palette.env (Saddle), chosen by
HEMO_MODE in theme.env. Role/custom accents are shaded per mode to stay legible
on the window background (UI >=3:1, text >=4.5:1 contrast).
"""
from __future__ import annotations

import glob
import json
import os
import pwd
import re
import shutil
import subprocess
import sys

try:
    import yaml
except ImportError:
    sys.stderr.write("hemo-role-apply: needs python3-yaml\n")
    sys.exit(2)

MANIFEST_DIR = os.environ.get("HEMO_MANIFEST_DIR", "/usr/share/hemo/manifest")
SHARE = "/usr/share/hemo"
POLICY_MASTER = os.path.join(SHARE, "policies.master.json")
POLICY_LIVE = "/etc/firefox-esr/policies/policies.json"
WALLPAPER_DIR = os.path.join(SHARE, "wallpapers")
STATE_DIR = "/var/lib/hemo"

RED = "\033[1;31m"
OFF = "\033[0m"


def log(msg):
    sys.stderr.write(f"{RED}[hemo-theme]{OFF} {msg}\n")


PALETTE = os.path.join(SHARE, "palette.env")

# Modes. kali = Kali's default terminal grey, black = true black; both are
# dark-based: accents shade toward white and GTK/pywal treat them as dark.
MODES = ("dark", "light", "kali", "black")
_BASE = {"dark": "dark", "light": "light", "kali": "dark", "black": "dark"}


def base(mode: str) -> str:
    """light or dark: the polarity a mode shades/derives like."""
    return _BASE.get(mode, "dark")


def norm_mode(v) -> str:
    v = str(v or "").strip().lower()
    return v if v in MODES else ("light" if v.startswith("l") else "dark")


# Saddle fallback if palette.env is absent (keeps the box themeable offline).
_FALLBACK = {
    "dark":  dict(desk="#14110e", bar="#1b1714", win="#221d19", panel="#2c2621",
                  border="#3f372f", text="#e8dfd4", muted="#a39686",
                  accent="#c9a37a", ok="#7cc794", warn="#e5b45a", bad="#f08a80"),
    "light": dict(desk="#d9cfc2", bar="#e4dccf", win="#f3eee7", panel="#e8e0d5",
                  border="#cbbfae", text="#2a241e", muted="#6b6157",
                  accent="#b08a62", ok="#2e7d4a", warn="#9a6a00", bad="#b3261e"),
    "kali":  dict(desk="#1b1d24", bar="#1f2129", win="#23252e", panel="#2d303b",
                  border="#40434f", text="#ffffff", muted="#a0a3b1",
                  accent="#367bf0", ok="#5ebdab", warn="#fea44c", bad="#ff5f5f"),
    "black": dict(desk="#000000", bar="#0a0a0a", win="#000000", panel="#141414",
                  border="#2a2a2a", text="#e6e6e6", muted="#8c8c8c",
                  accent="#c9a37a", ok="#7cc794", warn="#e5b45a", bad="#f08a80"),
}

# Polybar semantic bar colors (moss = network/ok, blood = target/alert). These are
# brand hues, not neutrals; they're shaded per mode toward legibility against the
# bar (unchanged on a dark bar, darkened on the light bar). Canonical = dark values.
MOSS = "#74a56e"
BLOOD = "#c41e2f"


def load_palette() -> dict:
    out = {}
    try:
        with open(PALETTE, encoding="utf-8") as fh:
            for ln in fh:
                s = ln.strip()
                if not s or s.startswith("#") or "=" not in s:
                    continue
                k, _, v = s.partition("=")
                parts = v.split()
                out[k.strip()] = parts[0].strip() if parts else ""
    except OSError:
        pass
    return out


def neutrals(mode: str, pal: dict) -> dict:
    M = mode.upper()
    keys = ("desk", "bar", "win", "panel", "border", "text", "muted",
            "accent", "ok", "warn", "bad")
    return {k: (pal.get(f"HEMO_{M}_{k.upper()}") or _FALLBACK[mode][k]) for k in keys}


def current_mode(pal: dict, home: str = "") -> str:
    # prefer the user's own choice (rootless, set via Appearance / --mode), then
    # the recorded theme.env, then the palette default.
    m = (_user_mode(home) if home else "") or _read_theme_env().get("HEMO_MODE") \
        or pal.get("HEMO_MODE_DEFAULT") or "dark"
    return norm_mode(m)


# ---------------------------------------------------------------- color maths
def _rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def _hx(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(round(c)))) for c in rgb)


def _lin(c):
    c /= 255.0
    return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4


def _lum(h):
    r, g, b = _rgb(h)
    return 0.2126 * _lin(r) + 0.7152 * _lin(g) + 0.0722 * _lin(b)


def _contrast(a, b):
    la, lb = _lum(a), _lum(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def _mix(h, toward, pct):
    a, b = _rgb(h), _rgb(toward)
    return _hx(tuple(a[i] + (b[i] - a[i]) * pct for i in range(3)))


def shade(raw, win, mode, ratio):
    """Nudge `raw` toward black (light base) / white (dark base) in 2% steps until
    it contrasts >= `ratio` against `win`; return raw unchanged if it already does."""
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", raw or ""):
        return raw
    toward = "#000000" if base(mode) == "light" else "#ffffff"
    cur = raw
    for step in range(0, 51):
        if _contrast(cur, win) >= ratio:
            return cur
        cur = _mix(raw, toward, 0.02 * step)
    return cur


def on_accent(fill, text_hex):
    """Readable text to place ON an accent fill: white or body text, whichever wins."""
    return "#ffffff" if _contrast("#ffffff", fill) >= _contrast(text_hex, fill) else text_hex


# ---------------------------------------------------------------- neutral writers
# Rewrite the mode-dependent neutral colors (backgrounds / borders / text) in each
# config, keyed on the setting name so they're value-independent and idempotent.
def _sub_keys(t, subs):
    for pat, val in subs:
        t = re.sub(pat, rf"\g<1>{val}", t)
    return t


