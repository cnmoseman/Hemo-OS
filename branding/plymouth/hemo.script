# Hemo — Plymouth boot glow.
# A centered logo whose opacity breathes on a sine wave, so the red eye
# pulses like a glow. One static PNG, no frame sequence.

Window.SetBackgroundTopColor(0.055, 0.067, 0.075);
Window.SetBackgroundBottomColor(0.035, 0.043, 0.049);

logo.image  = Image("logo.png");
logo.sprite = Sprite();
logo.sprite.SetImage(logo.image);
logo.sprite.SetZ(10);

# Positions are recomputed every frame: the screen size changes mid-boot when the
# GPU driver takes over from GRUB's framebuffer (e.g. 1920x1080 -> 1918x839 in the VM),
# and a position computed once at start leaves the logo off-centre.
fun place () {
    logo.sprite.SetX(Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
    logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
    if (msg.image) {
        msg.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - msg.image.GetWidth() / 2);
        msg.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 30);
    }
}

tick = 0;
fun refresh () {
    tick++;
    place();
    opacity = 0.70 + 0.30 * Math.Sin(tick / 20);
    logo.sprite.SetOpacity(opacity);
}
Plymouth.SetRefreshFunction(refresh);

# status / message line under the logo
msg.sprite = Sprite();
fun message (text) {
    msg.image = Image.Text(text, 0.60, 0.63, 0.61, 1, "JetBrains Mono 12");
    msg.sprite.SetImage(msg.image);
    place();
}
Plymouth.SetMessageFunction(message);

# password prompt (if disk encryption is ever added)
fun display_password (prompt, bullets) {
    message(prompt);
}
Plymouth.SetDisplayPasswordFunction(display_password);
