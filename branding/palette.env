# Hemo OS base palette: "Saddle" (chosen by the user 2026-10-05).
# Single source of truth for the desktop's neutral colors per mode: light, dark,
# kali (Kali's terminal grey) and black.
# Shell-sourceable. To parse elsewhere: KEY=VALUE lines, value ends at the first whitespace.
#
# Roles only change the ACCENT. Everything below stays the same for every role.
# Logo disc brown is #966b4f (branding/assets/HemoLogoNew.png); default accents sit a step lighter.

HEMO_PALETTE=saddle
HEMO_MODE_DEFAULT=dark

# --- light mode ---------------------------------------------------------
HEMO_LIGHT_DESK=#d9cfc2      # root window / behind windows (when no wallpaper)
HEMO_LIGHT_BAR=#e4dccf       # polybar, rofi banner strip
HEMO_LIGHT_WIN=#f3eee7       # window / terminal / GTK background
HEMO_LIGHT_PANEL=#e8e0d5     # cards, sidebars, unfocused i3 titlebar, inputs
HEMO_LIGHT_BORDER=#cbbfae    # unfocused borders, separators
HEMO_LIGHT_TEXT=#2a241e
HEMO_LIGHT_MUTED=#6b6157     # secondary text, inactive workspaces
HEMO_LIGHT_ACCENT=#b08a62    # default (no-role) accent, RAW: run through the shading rule, or use:
HEMO_LIGHT_ACCENT_UI=#a5825c   # >=3:1 vs WIN (borders, titlebar, workspace, buttons)
HEMO_LIGHT_ACCENT_TEXT=#826649 # >=4.5:1 vs WIN (links, accent text)
HEMO_LIGHT_OK=#2e7d4a
HEMO_LIGHT_WARN=#9a6a00
HEMO_LIGHT_BAD=#b3261e

# --- dark mode ----------------------------------------------------------
HEMO_DARK_DESK=#14110e
HEMO_DARK_BAR=#1b1714
HEMO_DARK_WIN=#221d19
HEMO_DARK_PANEL=#2c2621
HEMO_DARK_BORDER=#3f372f
HEMO_DARK_TEXT=#e8dfd4
HEMO_DARK_MUTED=#a39686
HEMO_DARK_ACCENT=#c9a37a     # RAW (already passes both thresholds in dark)
HEMO_DARK_ACCENT_UI=#c9a37a
HEMO_DARK_ACCENT_TEXT=#c9a37a
HEMO_DARK_OK=#7cc794
HEMO_DARK_WARN=#e5b45a
HEMO_DARK_BAD=#f08a80

# --- kali mode (Kali's default terminal grey) --------------------------
# WIN/TEXT = QTerminal "Kali-Dark" background/foreground (35,37,46 / white);
# the rest are cool greys built around it. Dark-based (accents shade like dark).
HEMO_KALI_DESK=#1b1d24
HEMO_KALI_BAR=#1f2129
HEMO_KALI_WIN=#23252e
HEMO_KALI_PANEL=#2d303b
HEMO_KALI_BORDER=#40434f
HEMO_KALI_TEXT=#ffffff
HEMO_KALI_MUTED=#a0a3b1
HEMO_KALI_ACCENT=#367bf0     # Kali blue (default, no-role accent)
HEMO_KALI_OK=#5ebdab
HEMO_KALI_WARN=#fea44c
HEMO_KALI_BAD=#ff5f5f

# --- black mode (true black) --------------------------------------------
HEMO_BLACK_DESK=#000000
HEMO_BLACK_BAR=#0a0a0a
HEMO_BLACK_WIN=#000000
HEMO_BLACK_PANEL=#141414
HEMO_BLACK_BORDER=#2a2a2a
HEMO_BLACK_TEXT=#e6e6e6
HEMO_BLACK_MUTED=#8c8c8c
HEMO_BLACK_ACCENT=#c9a37a
HEMO_BLACK_OK=#7cc794
HEMO_BLACK_WARN=#e5b45a
HEMO_BLACK_BAD=#f08a80

# --- accent shading rule ------------------------------------------------
# A role accent keeps its hue but is nudged per mode until it reads on WIN
# (kali and black shade like dark):
#   UI shade   (borders, focused titlebar, active workspace, button fill): contrast >= 3.0 vs WIN
#   TEXT shade (links, accent-colored text, prompt user@host):           contrast >= 4.5 vs WIN
# Light mode mixes toward #000000, dark mode toward #ffffff, in sRGB steps of 2% until the
# WCAG ratio is met. Text ON an accent fill uses #ffffff or TEXT, whichever contrasts more.
# Custom accents from the color picker must go through the same rule.
#
# Precomputed for roles.yml accents (raw -> UI / TEXT):
#   role            raw       light UI  light TEXT  dark UI   dark TEXT
#   default         -         #a5825c   #826649     #c9a37a   #c9a37a
#   red_team        #c41e2f   #c41e2f   #c41e2f     #c82c3b   #d6626d
#   pentest         #e0a93b   #aa802d   #866523     #e0a93b   #e0a93b
#   web             #9b6dd6   #9b6dd6   #7f59af     #9b6dd6   #9d70d7
#   reverse         #d9763b   #cc6f37   #a1572c     #d9763b   #d9763b
#   blue_host       #3a8ed0   #3a8ed0   #2d6fa2     #3a8ed0   #3a8ed0
#   blue_net        #2bb3a3   #249689   #1c766c     #2bb3a3   #2bb3a3
#   vuln_assessor   #b5c23a   #86902b   #697122     #b5c23a   #b5c23a
#   full            #8f9aa3   #818b93   #646c72     #8f9aa3   #8f9aa3
